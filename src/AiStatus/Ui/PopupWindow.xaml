<Window x:Class="AiStatus.Ui.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AiStatus.Ui.Controls"
        xmlns:ui="clr-namespace:AiStatus.Ui"
        Title="AI status"
        MinWidth="340"
        MaxWidth="420"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        WindowStyle="None"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border Padding="6"
            Background="#161C23"
            BorderBrush="#8F9CAA"
            BorderThickness="1"
            CornerRadius="5">
        <ItemsControl ItemsSource="{Binding Providers, RelativeSource={RelativeSource AncestorType={x:Type ui:PopupWindow}}}">
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Margin" Value="0,0,0,6" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <controls:ProviderCard PollInterval="{Binding PollInterval, RelativeSource={RelativeSource AncestorType={x:Type ui:PopupWindow}}}"
                                           Snapshot="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>
